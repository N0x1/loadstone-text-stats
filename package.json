{
  "name": "text-stats",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Count characters, words and lines from text or standard input.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "text-stats": "src/cli.mjs"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "package.json",
    "test/",
    "scripts/package.mjs",
    "scripts/runtime-check.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node src/cli.mjs",
    "runtime-check": "node scripts/runtime-check.mjs",
    "package": "node scripts/package.mjs"
  },
  "author": "Noxie",
  "repository": {
    "type": "git",
    "url": "https://github.com/N0x1/text-stats.git"
  }
}
