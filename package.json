{
  "name": "loadstone-text-stats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dependency-free offline CLI for Unicode character, word and line counts",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "loadstone-text-stats": "src/cli.mjs"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "package.json",
    "test/",
    "scripts/package.mjs",
    "scripts/runtime-check.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node src/cli.mjs",
    "runtime-check": "node scripts/runtime-check.mjs",
    "package": "node scripts/package.mjs"
  }
}
